DATABASE_URL=postgresql://mir:change-me@localhost:5432/mir_wordcloud
APP_ORIGIN=http://localhost:3000
GIGACHAT_ENABLED=false
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=
GIGACHAT_TIMEOUT_MS=20000
GIGACHAT_MAX_INPUT_WORDS=150
# Use a mounted, verified CA bundle when enabling GigaChat.
# NODE_EXTRA_CA_CERTS=/run/certs/russian-trusted-ca.pem
# Preferred: trust this bundle only for server-side GigaChat requests.
# GIGACHAT_CA_BUNDLE=/run/certs/russian-trusted-ca.pem
# Alternative to GIGACHAT_AUTH_KEY: mounted secret file (never commit it).
# GIGACHAT_AUTH_KEY_FILE=/run/secrets/gigachat_auth_key
# First admin bootstrap only. Mount the password outside this repository.
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# Automatic contextual classification; independent from organizer AI model.
GIGACHAT_SEMANTIC_MODEL=GigaChat-2-Pro
