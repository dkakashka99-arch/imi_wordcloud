NODE_ENV=production
APP_ORIGIN=https://imi-cloudpoll.ru
DATABASE_URL=postgresql://mir:REPLACE_WITH_SAME_HEX_PASSWORD@db:5432/mir_wordcloud
DB_POOL_MAX=10
GIGACHAT_ENABLED=false
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=
GIGACHAT_TIMEOUT_MS=20000
GIGACHAT_MAX_INPUT_WORDS=150
GIGACHAT_CA_BUNDLE=/run/certs/russian-trusted-ca.pem

# Automatic contextual classification; independent from organizer AI model.
GIGACHAT_SEMANTIC_MODEL=GigaChat-2-Pro
