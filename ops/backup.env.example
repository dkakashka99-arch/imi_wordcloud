# Choose an existing FREE off-VPS destination; do not order paid storage.
# Example: an existing machine with SFTP, or an existing S3-compatible bucket.
RESTIC_REPOSITORY=sftp:backup@YOUR_EXISTING_HOST:/path/imi-wordcloud
RESTIC_PASSWORD_FILE=/opt/imi-wordcloud/shared/restic-password
# Pin remote host key in /home/deploy/.ssh/known_hosts before using SFTP.
# S3 needs AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY here, not in GitHub.
